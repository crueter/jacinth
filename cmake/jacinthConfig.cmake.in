@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(yyjson)

option(JACINTH_USE_REFLECTION
    "Use C++26 reflection features instead of Boost.PFR" OFF)

if (NOT JACINTH_USE_REFLECTION)
    find_dependency(Boost COMPONENTS headers)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/jacinthTargets.cmake")

set(link yyjson)

if (JACINTH_USE_REFLECTION)
    target_compile_definitions(jacinth::jacinth INTERFACE JACINTH_USE_REFLECTION)
    target_compile_options(jacinth::jacinth INTERFACE
        $<$<COMPILE_LANGUAGE:CXX>:-freflection>)
    target_compile_features(jacinth::jacinth INTERFACE cxx_std_26)
else()
    list(APPEND link Boost::headers)
    target_compile_features(jacinth::jacinth INTERFACE cxx_std_23)
endif()

# boost is only needed if reflection is OFF
set_target_properties(jacinth::jacinth PROPERTIES
  IMPORTED_CXX_MODULES_LINK_LIBRARIES "${link}"
  INTERFACE_LINK_LIBRARIES "${link}")

# ccache and sccache do not play very nicely with modules
# This will be removed eventually
get_target_property(launcher jacinth::jacinth CXX_COMPILER_LAUNCHER)
if ("${launcher}" MATCHES "ccache")
    set_target_properties(jacinth::jacinth PROPERTIES
        CXX_COMPILER_LAUNCHER ""
        C_COMPILER_LAUNCHER "")
endif()

# GCC 15 ICE
if (CMAKE_CXX_COMPILER_ID STREQUAL "GNU"
        AND CMAKE_CXX_COMPILER_VERSION VERSION_LESS 15.3)
    target_compile_options(jacinth PUBLIC "-fdisable-tree-ealias")
endif()
